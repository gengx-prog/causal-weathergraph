# Preserve publication artifacts byte-for-byte on every platform.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary

# Keep executable research scripts portable.
*.py text eol=lf
*.sh text eol=lf

# Keep the raw release inventory identical to its downloadable copy.
artifacts/raw-data-manifest.json text eol=lf
artifacts/RAW_SHA256SUMS.txt text eol=lf

# Keep repository manuscript sources identical to the source ZIP.
manuscript/** -text

# The archived reviewer-comment JSON preserves its original CRLF bytes.
manuscript/reviews_20261008/canonical_comments.json whitespace=cr-at-eol
